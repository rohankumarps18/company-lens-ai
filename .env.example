# Copy this file to .env and fill in real values for local development.
# Never commit the real .env or a real service-account JSON file to git.

ENVIRONMENT=development
LOG_LEVEL=INFO
API_KEY=local-dev-key-change-in-production
PORT=8000

# Postgres connection string (Neon, Render Postgres, local, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Google Sheets — the ID from the sheet URL, and the raw JSON contents
# (as a single-line string) of a Google service account key with edit
# access to the sheet. Prefer setting GOOGLE_SERVICE_ACCOUNT_JSON directly
# as an env var in production; only use a credentials.json file locally,
# and never commit it.
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}

POLL_INTERVAL_SECONDS=300
